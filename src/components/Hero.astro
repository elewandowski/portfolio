---
import Umbrella from "../assets/umbrella.svg";
import LinkedInIcon from "../assets/linkedin.svg";
import GitHubIcon from "../assets/github.svg";
---

<section id="hero">
  <div class="hero-content">
    <p class="eyebrow">Hi, I'm</p>
    <h1>Emil Lewandowski</h1>
    <p class="tagline">Software Engineer based in Berlin</p>
    <p class="intro">
      I build web applications and the tooling that keeps them shipping — from
      frontend interfaces to the CI/CD pipelines and tests behind them.
    </p>
    <a
      class="btn"
      href="https://www.linkedin.com/in/emillewandowski/"
      target="_blank"
      rel="noopener"
    >
      <LinkedInIcon />
      LinkedIn
    </a>
    <a
      class="btn"
      href="https://github.com/elewandowski"
      target="_blank"
      rel="noopener"
    >
      <GitHubIcon />
      GitHub
    </a>
  </div>
  <Umbrella class="umbrella" />
</section>

<style>
  #hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 8px 0 16px;
    width: calc(100% - 32px);
  }

  .hero-content {
    max-width: 520px;
  }

  .eyebrow {
    color: var(--accent);
    font-family: var(--font-LibreBaskerville);
    font-style: italic;
    margin-bottom: 4px;
  }

  #hero h1 {
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: #0f172a;
  }

  .tagline {
    color: #374151;
    font-family: var(--font-LibreBaskerville);
    font-size: 18px;
    margin-bottom: 20px;
  }

  .intro {
    font-size: 17px;
    line-height: 1.6;
    color: #4b5563;
    margin-bottom: 28px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: white;
    color: #111827;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition:
      border-color 0.15s,
      color 0.15s,
      transform 0.15s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .btn.primary:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: white;
  }

  .umbrella {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 140px;
    height: 140px;
    color: #e5e7eb;
    transform: rotate(27deg);
    opacity: 0.55;
    pointer-events: none;
    z-index: -1;
  }

  @media screen and (max-width: 768px) {
    .umbrella {
      width: 100px;
      height: 100px;
      opacity: 0.35;
    }
  }
</style>
