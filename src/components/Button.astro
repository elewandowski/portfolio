---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href}>
  <slot />
</a>

<style>
  a {
    display: block;
    padding: 10px 12px;
    color: #111827;
    text-decoration: none;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: border-color 0.2s;
  }

  a:hover {
    border: 1px solid #e5e7eb;
  }
</style>
