---
interface Props {
  href: string;
  external?: boolean;
}

const { href, external = false } = Astro.props;
---

<a
  class="btn"
  href={href}
  {...external && { target: "_blank", rel: "noopener" }}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: white;
    color: #111827;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition:
      border-color 0.15s,
      color 0.15s,
      transform 0.15s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
</style>
