---
interface Props {
  id: string;
  title: string;
  description: string;
}

const { id, title, description } = Astro.props;
---

<a href={`/projects/${id}`}>
  <section class="card">
    <h2>{title}</h2>
    <p>
      {description}
    </p>
  </section>
</a>

<style>
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1rem;
    width: 100%;
    box-sizing: border-box;
  }
</style>
