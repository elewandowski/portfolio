---
import Button from "./Button.astro";

interface Props {
  links?: { href: string; label: string }[];
}

const {
  links = [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
  ],
} = Astro.props;
---

<div id="header">
  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <Button href={`${import.meta.env.BASE_URL}${link.href}`}>
              {link.label}
            </Button>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  #header {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #e5e7eb;
    padding: 16px;
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    z-index: 100;
  }

  nav {
    margin: auto;
    width: 100%;
    max-width: 760px;
  }

  nav ul {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
