---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { project: project.id },
    props: {
      title: project.data.title,
      subtitle: project.data.subtitle,
      description: project.data.description,
      url: project.data.url,
      img: project.data.img,
    },
  }));
}

const { title, subtitle, description, url, img } = Astro.props;
---

<Layout>
  <main>
    <section id="hero">
      <p class="eyebrow">Project</p>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
    </section>

    <section class="block">
      <h2>Overview</h2>
      <p class="body">
        {description}
      </p>
      {url && <a href={url}>Click here to see it</a>}
      {img && <Image src={img} alt={title} />}
    </section>
  </main>
</Layout>

<style>
  main {
    gap: 32px;
  }

  #hero {
    padding: 0 0 8px;
    width: calc(100% - 32px);
  }

  .eyebrow {
    color: var(--accent);
    font-family: var(--font-LibreBaskerville);
    font-style: italic;
    margin-bottom: 4px;
  }

  #hero h1 {
    font-size: clamp(36px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: #0f172a;
  }

  .subtitle {
    color: #4b5563;
    font-family: var(--font-LibreBaskerville);
    font-size: 18px;
    line-height: 1.5;
    max-width: 600px;
  }

  .block {
    width: 100%;
    box-sizing: border-box;
  }

  .block h2 {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  .body {
    font-size: 16px;
    line-height: 1.6;
    color: #374151;
    max-width: 640px;
  }

  img {
    padding: 20px 0;
    max-width: 100%;
    height: auto;
  }

  @media screen and (max-width: 768px) {
    main {
      gap: 24px;
    }
  }
</style>
