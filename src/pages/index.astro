---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";

const projects = await getCollection("projects");

const experience = [
  {
    company: "Pitch",
    role: "Software Engineer",
    period: "Most recent",
  },
  {
    company: "Wunderflats",
    role: "Software Engineer",
    period: "Previously",
  },
];

const skills = ["Frontend development", "QA engineering", "CI/CD pipelines"];

const technologies = [
  "React",
  "TypeScript",
  "Github Actions",
  "CircleCI",
  "Cypress",
  "Playwright",
  "Jest",
];
---

<Layout>
  <main>
    <Hero />

    <section class="block">
      <h2>Experience</h2>
      <ul class="experience">
        {
          experience.map((job) => (
            <Card title={job.company} description={job.role} />
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2>Skills</h2>
      <ul class="skills">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Technologies</h2>
      <ul class="chips">
        {technologies.map((tech) => <li class="chip">{tech}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Featured projects</h2>
      <div class="projects">
        {
          projects.map((project) => (
            <Card
              href={project.data.id}
              title={project.data.title}
              description={project.data.description}
            />
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    gap: 56px;
  }

  /* Blocks */
  .block {
    width: 100%;
    margin: 0;
    box-sizing: border-box;
    padding-right: 32px;
  }

  .block h2 {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 20px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  /* Experience */
  .experience {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  /* Skills */
  .skills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .skills li {
    padding: 14px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: white;
    color: #111827;
    font-size: 15px;
  }

  /* Chips */
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    background: white;
    font-size: 13px;
    color: #374151;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Projects */
  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  @media screen and (max-width: 768px) {
    /* main {
      gap: 46px;
    } */

    .experience,
    .skills,
    .projects {
      grid-template-columns: 1fr;
      max-width: 50%;
    }

    .block {
      padding-right: 0;
    }
  }
</style>
